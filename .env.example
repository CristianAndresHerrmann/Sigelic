# =======================================================================
# SIGELIC - Variables de Entorno (EJEMPLO)
# =======================================================================
# Copiar este archivo como .env y configurar con los valores reales
# cp .env.example .env

# =======================================================================
# DESARROLLO LOCAL (perfil dev)
# =======================================================================

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sigelic
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Puerto del servidor
SERVER_PORT=8080

# Perfil activo (dev, test, prod)
SPRING_PROFILES_ACTIVE=dev

# =======================================================================
# DESPLIEGUE EN OCI (perfil prod) - ver docs/deploy-oci.md
# =======================================================================
# El perfil prod ignora DB_HOST/DB_PORT/DB_NAME y usa la URL JDBC completa,
# porque MySQL HeatWave exige TLS y la URL de desarrollo lleva useSSL=false.
#
# Ejemplo con el endpoint privado del DB System:
# DB_URL=jdbc:mysql://10.0.1.10:3306/sigelic?sslMode=REQUIRED&serverTimezone=America/Argentina/Buenos_Aires
DB_URL=

# Contrasenas iniciales de las cuentas con permisos totales.
# OBLIGATORIAS en el perfil prod: si faltan, la aplicacion no arranca.
# Solo se usan al crear la cuenta; despues se administran desde la aplicacion.
SIGELIC_ADMIN_PASSWORD=
SIGELIC_SUPERADMIN_PASSWORD=

# Dominio publico para el certificado TLS de Caddy
SIGELIC_DOMAIN=sigelic.duckdns.org

# Ajustes de JVM (por defecto en el Dockerfile: G1GC al 50% de la RAM)
# JAVA_OPTS=-XX:+UseG1GC -XX:MaxRAMPercentage=50.0

# Tamano del pool de conexiones (por defecto 10 / 2)
# DB_POOL_MAX=10
# DB_POOL_MIN=2

# =======================================================================
# CONFIGURACION DE SEGURIDAD (para futuro)
# =======================================================================

# JWT Secret (generar uno seguro en producción)
# JWT_SECRET=your-secret-key-here

# =======================================================================
# CONFIGURACION DE EMAIL (para futuro)
# =======================================================================

# SMTP
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@domain.com
# MAIL_PASSWORD=your-app-password
